{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gemfire-application-config/application-config.schema.json",
  "title": "GemFire/Geode shared application-environment configuration",
  "description": "One values.yaml per <application>/<environment>. The SAME file is deployed to the Primary and the DR site. Site identity (distributed-system-id, locators, remote-locators, receiver endpoints, Service names, certificates) is NOT part of this schema; it is generated by gemfire-k8s-helm at deploy time. Cross-field rules that JSON Schema cannot express are enforced by scripts/validate-config.sh in gemfire-k8s-helm (see schemas/README.md).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "application", "gemfire", "resources", "storage", "wan"],
  "properties": {
    "schemaVersion": {
      "description": "Version of this schema contract. Bump only with a documented migration.",
      "const": 1
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "environment"],
      "properties": {
        "name": {
          "description": "Lower-case application code. Must equal the parent folder name (checked by the pipeline).",
          "type": "string",
          "pattern": "^[a-z][a-z0-9]{1,15}$"
        },
        "environment": {
          "description": "Must equal the folder name. prod=1, dev=2, stg=3, qa=4 in the distributed-system-id scheme (<ENV><SITE>).",
          "enum": ["prod", "dev", "stg", "qa"]
        }
      }
    },
    "gemfire": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cluster", "regions", "pdx", "resourceManager"],
      "properties": {
        "cluster": {
          "type": "object",
          "additionalProperties": false,
          "required": ["memberCount", "locatorCount"],
          "properties": {
            "memberCount": {
              "description": "Data servers PER SITE. Primary and DR use the same value.",
              "type": "integer", "minimum": 2, "maximum": 20
            },
            "locatorCount": {
              "description": "Locators PER SITE. Primary and DR use the same value.",
              "type": "integer", "minimum": 1, "maximum": 5
            }
          }
        },
        "jvm": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "heapPercentOfMemoryLimit": {
              "description": "JVM max heap as a percentage of the member container memory limit. Remaining memory is for metaspace, direct buffers, thread stacks and the OS page cache.",
              "type": "integer", "minimum": 40, "maximum": 75
            }
          }
        },
        "properties": {
          "description": "Application-level gemfire.properties. Allow-listed keys only. Identity, security and WAN-endpoint properties are chart-owned and are rejected here.",
          "type": "object",
          "propertyNames": {
            "enum": [
              "log-level", "log-file-size-limit", "log-disk-space-limit",
              "member-timeout", "conserve-sockets", "enable-network-partition-detection",
              "disable-auto-reconnect", "max-wait-time-reconnect",
              "statistic-sampling-enabled", "archive-disk-space-limit", "archive-file-size-limit"
            ]
          },
          "additionalProperties": { "type": ["string", "integer", "boolean"] }
        },
        "cacheServer": {
          "description": "Client-facing cache server settings.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxConnections": { "type": "integer", "minimum": 16, "maximum": 20000 },
            "maxThreads": { "type": "integer", "minimum": 0, "maximum": 5000 },
            "maximumTimeBetweenPingsMs": { "type": "integer", "minimum": 1000, "maximum": 600000 }
          }
        },
        "diskStore": {
          "description": "Settings for the single persistent disk store used by all regions of this application. Overflow and persistence share the store.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "autoCompact": { "type": "boolean" },
            "compactionThreshold": { "type": "integer", "minimum": 1, "maximum": 100 },
            "maxOplogSizeMb": { "type": "integer", "minimum": 1, "maximum": 10240 },
            "allowForceCompaction": { "type": "boolean" },
            "queueSize": { "type": "integer", "minimum": 0, "maximum": 100000 },
            "diskUsageWarningPercentage": { "type": "integer", "minimum": 1, "maximum": 99 },
            "diskUsageCriticalPercentage": { "type": "integer", "minimum": 2, "maximum": 100 }
          }
        },
        "regions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/region" }
        },
        "pdx": {
          "type": "object",
          "additionalProperties": false,
          "required": ["readSerialized", "ignoreUnreadFields", "persistent"],
          "properties": {
            "readSerialized": { "type": "boolean" },
            "ignoreUnreadFields": {
              "description": "true drops fields a member does not know about when it re-serializes an object. Unsafe during rolling upgrades that add fields; keep false in prod.",
              "type": "boolean"
            },
            "persistent": {
              "description": "Persist the PDX type registry. Must be true when any region is persistent (always true in this schema version).",
              "const": true
            },
            "autoSerializableClasses": {
              "description": "Regex patterns for ReflectionBasedAutoSerializer, e.g. com\\.example\\.ecom\\.model\\..*",
              "type": "array",
              "items": { "type": "string", "minLength": 1, "maxLength": 200 },
              "uniqueItems": true
            }
          }
        },
        "resourceManager": {
          "description": "Heap-based resource manager. evictionHeapPercentage must be lower than criticalHeapPercentage (cross-field check in scripts). With region eviction action OVERFLOW_TO_DISK, crossing the eviction threshold moves values to disk; it does NOT destroy data.",
          "type": "object",
          "additionalProperties": false,
          "required": ["evictionHeapPercentage", "criticalHeapPercentage"],
          "properties": {
            "evictionHeapPercentage": { "type": "integer", "minimum": 30, "maximum": 90 },
            "criticalHeapPercentage": { "type": "integer", "minimum": 50, "maximum": 98 }
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["member"],
      "properties": {
        "member": { "$ref": "#/$defs/resourceBlock" },
        "locator": { "$ref": "#/$defs/resourceBlock" }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size", "storageClassName"],
      "properties": {
        "size": { "description": "Per-member PVC size (persistence + overflow).", "type": "string", "pattern": "^[0-9]+(Gi|Ti)$" },
        "locatorSize": { "description": "Per-locator PVC size.", "type": "string", "pattern": "^[0-9]+(Gi|Ti)$" },
        "storageClassName": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$", "maxLength": 63 }
      }
    },
    "wan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "mode": { "description": "Logical topology. Partner is always the other site of the same application/environment; selected by the chart, never by this file.", "const": "ACTIVE_ACTIVE" },
        "sender": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "parallel": { "type": "boolean" },
            "persistent": { "description": "Persist the gateway queue to the disk store so queued events survive restarts.", "type": "boolean" },
            "dispatcherThreads": { "type": "integer", "minimum": 1, "maximum": 32 },
            "batchSize": { "type": "integer", "minimum": 1, "maximum": 100000 },
            "batchTimeIntervalMs": { "type": "integer", "minimum": 1, "maximum": 60000 },
            "maximumQueueMemoryMb": { "type": "integer", "minimum": 1, "maximum": 10240 },
            "orderPolicy": { "enum": ["KEY", "PARTITION", "THREAD"] },
            "conflationEnabled": { "description": "Keep false for active-active unless every consumer tolerates dropped intermediate events.", "type": "boolean" },
            "diskSynchronous": { "type": "boolean" },
            "alertThresholdMs": { "type": "integer", "minimum": 0, "maximum": 3600000 }
          }
        },
        "receiver": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maximumTimeBetweenPingsMs": { "type": "integer", "minimum": 1000, "maximum": 600000 },
            "socketBufferSize": { "type": "integer", "minimum": 1024, "maximum": 16777216 }
          }
        }
      },
      "if": { "properties": { "enabled": { "const": true } } },
      "then": { "required": ["mode", "sender"] }
    }
  },
  "allOf": [
    {
      "description": "Environment policy: prod.",
      "if": { "properties": { "application": { "properties": { "environment": { "const": "prod" } } } } },
      "then": {
        "properties": {
          "gemfire": {
            "properties": {
              "pdx": { "properties": { "ignoreUnreadFields": { "const": false } } },
              "regions": { "items": { "properties": { "redundantCopies": { "minimum": 1 } } } }
            },
            "required": ["jvm", "diskStore"]
          },
          "wan": { "properties": { "enabled": { "const": true } } },
          "resources": { "required": ["member", "locator"] },
          "storage": { "required": ["size", "storageClassName", "locatorSize"] }
        }
      }
    },
    {
      "description": "Environment policy: non-prod environments may use smaller sizing but still need redundancy for DR-first rehearsal.",
      "if": { "properties": { "application": { "properties": { "environment": { "enum": ["dev", "stg", "qa"] } } } } },
      "then": {
        "properties": {
          "gemfire": { "properties": { "regions": { "items": { "properties": { "redundantCopies": { "minimum": 1 } } } } } }
        }
      }
    }
  ],
  "$defs": {
    "quantityCpu": { "type": "string", "pattern": "^([0-9]+m|[0-9]+(\\.[0-9]+)?)$" },
    "quantityMemory": { "type": "string", "pattern": "^[0-9]+(Mi|Gi|Ti)$" },
    "resourceBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": {
          "type": "object", "additionalProperties": false, "required": ["cpu", "memory"],
          "properties": { "cpu": { "$ref": "#/$defs/quantityCpu" }, "memory": { "$ref": "#/$defs/quantityMemory" } }
        },
        "limits": {
          "type": "object", "additionalProperties": false, "required": ["cpu", "memory"],
          "properties": { "cpu": { "$ref": "#/$defs/quantityCpu" }, "memory": { "$ref": "#/$defs/quantityMemory" } }
        }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "redundantCopies"],
      "properties": {
        "name": {
          "description": "Upper-case region name. Unique within the file (checked by script).",
          "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "type": {
          "description": "Region shortcut. Only the persistent, overflow-capable partitioned shortcut is supported in schema v1.",
          "enum": ["PARTITION_PERSISTENT_OVERFLOW"]
        },
        "redundantCopies": {
          "description": "Must be <= memberCount - 1 (checked by script).",
          "type": "integer", "minimum": 0, "maximum": 3
        },
        "totalNumBuckets": {
          "description": "Fixed at region creation; cannot be changed later without recreating the region. Choose well above the maximum expected member count.",
          "type": "integer", "minimum": 1, "maximum": 65536
        },
        "replicateOverWan": {
          "description": "Attach the application gateway sender to this region. Defaults to true when wan.enabled is true.",
          "type": "boolean"
        },
        "eviction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy", "action"],
          "properties": {
            "policy": { "enum": ["HEAP_LRU", "ENTRY_COUNT", "MEMORY_SIZE"] },
            "maximum": { "description": "Required for ENTRY_COUNT (entries) and MEMORY_SIZE (MB); not allowed for HEAP_LRU.", "type": "integer", "minimum": 1 },
            "action": {
              "description": "Only OVERFLOW_TO_DISK is allowed: LOCAL_DESTROY would silently drop required data on a persistent region.",
              "const": "OVERFLOW_TO_DISK"
            }
          }
        },
        "expiration": {
          "description": "Entry-level expiration. TTL = time since last create/update. Idle = time since last access. Expiration is NOT eviction: it deletes or invalidates entries. Region-level expiration is intentionally not offered for partitioned regions in schema v1.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ttl": { "$ref": "#/$defs/expirationRule" },
            "idleTimeout": { "$ref": "#/$defs/expirationRule" }
          }
        },
        "indexes": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "expression", "type"],
            "properties": {
              "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$" },
              "expression": { "description": "Indexed OQL expression, e.g. customerId.", "type": "string", "minLength": 1, "maxLength": 200 },
              "type": {
                "description": "FUNCTIONAL maps to gfsh type=range, PRIMARY_KEY to type=key. HASH is deprecated upstream and rejected in this schema version.",
                "enum": ["FUNCTIONAL", "PRIMARY_KEY"]
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "eviction": { "properties": { "policy": { "const": "HEAP_LRU" } } } }, "required": ["eviction"] },
          "then": { "properties": { "eviction": { "not": { "required": ["maximum"] } } } }
        },
        {
          "if": { "properties": { "eviction": { "properties": { "policy": { "enum": ["ENTRY_COUNT", "MEMORY_SIZE"] } } } }, "required": ["eviction"] },
          "then": { "properties": { "eviction": { "required": ["maximum"] } } }
        }
      ]
    },
    "expirationRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeoutSeconds", "action"],
      "properties": {
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 31536000 },
        "action": { "description": "Local actions are not valid for partitioned regions.", "enum": ["DESTROY", "INVALIDATE"] }
      }
    }
  }
}
